# TrustVault Frontend Environment Configuration Example

# Express Backend Base URL (Proxied via Vite dev server in development)
VITE_API_URL=http://localhost:5000

# Mock Mode (default: false). Only set to 'true' for offline manual testing without a backend
VITE_USE_MOCK=false

# -----------------------------------------------------------------------------
# Firebase Client SDK Configuration (Required for Owner & Viewer Email OTP)
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web app
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyPlaceholderApiKey123456789
VITE_FIREBASE_AUTH_DOMAIN=trustvault-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=trustvault-prod
VITE_FIREBASE_STORAGE_BUCKET=trustvault-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
